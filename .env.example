# Environment Variables Template
# Copy this file to .env.local and add your real API keys if available.
# The application includes fully functioning mock/fallback providers,
# so the dashboard works out-of-the-box even without external API keys!

# News API (https://newsapi.org or GNews / Currents)
NEXT_PUBLIC_NEWS_API_KEY=your_news_api_key_here
NEXT_PUBLIC_NEWS_API_URL=https://newsapi.org/v2

# TMDB API (The Movie Database: https://www.themoviedb.org)
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here
NEXT_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3

# Spotify Web API (Optional Client ID)
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# App configuration
NEXT_PUBLIC_APP_NAME="Aura Feed — Personalized Content Discovery"
NEXT_PUBLIC_ENABLE_REALTIME_SIMULATION=true
